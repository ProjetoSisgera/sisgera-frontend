# Lido só no `npm start`. Sem segredos aqui: este arquivo vai para o Git.
# Para apontar para outras URLs na sua máquina, use um .env.development.local.

# URLs das APIs rodando localmente. Também entram na Content Security Policy do
# public/index.html; sem elas, o navegador bloquearia as chamadas às APIs.
REACT_APP_AUTH_API_URL=http://localhost:3000
REACT_APP_OCCURRENCE_API_URL=http://localhost:3002
REACT_APP_INVENTORY_API_URL=http://localhost:3004
