# Lido só no `npm run build`. Sem segredos aqui: este arquivo vai para o Git.
# As URLs das APIs vêm do Railway (REACT_APP_*), que têm prioridade sobre este arquivo.

# Gera o runtime do webpack como arquivo, e não como <script> inline no
# index.html. A Content Security Policy (public/index.html) bloqueia script inline.
INLINE_RUNTIME_CHUNK=false
